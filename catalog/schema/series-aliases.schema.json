{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/awuzag/ecos/catalog/schema/series-aliases.schema.json",
  "title": "ECOS logical indicator aliases",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "indicators"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "checked_at", "format", "source_of_truth"],
      "properties": {
        "provider": {
          "const": "BOK ECOS"
        },
        "checked_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "format": {
          "const": "json"
        },
        "source_of_truth": {
          "const": "KeyStatisticList + targeted StatisticItemList/StatisticSearch mappings"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/indicator"
      }
    }
  },
  "definitions": {
    "cycle": {
      "enum": ["A", "S", "Q", "M", "SM", "D"]
    },
    "status": {
      "enum": ["queryable", "verified", "needs_review", "deprecated"]
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_ko",
        "category",
        "stat_code",
        "item_codes",
        "preferred_cycle",
        "available_cycles",
        "periods"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "name_ko": {
          "type": "string",
          "minLength": 1
        },
        "name_en": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key_statistic": {
          "$ref": "#/definitions/key_statistic_link"
        },
        "stat_code": {
          "type": "string",
          "minLength": 1
        },
        "item_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preferred_cycle": {
          "$ref": "#/definitions/cycle"
        },
        "available_cycles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/cycle"
          }
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/period"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "key_statistic_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_ko"],
      "properties": {
        "class_name": {
          "type": "string"
        },
        "name_ko": {
          "type": "string",
          "minLength": 1
        },
        "reference_time_semantics": {
          "const": "latest_value_reference_time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "series_key", "status"],
      "properties": {
        "cycle": {
          "$ref": "#/definitions/cycle"
        },
        "series_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+:[ASQMD]{1,2}:[^\\s:]+(?::[^\\s:]+){0,3}$"
        },
        "start_time": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        },
        "data_count": {
          "type": "integer",
          "minimum": 0
        },
        "unit_name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
